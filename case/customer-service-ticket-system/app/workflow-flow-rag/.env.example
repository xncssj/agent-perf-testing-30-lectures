# 客服工单 Workflow+RAG - 环境变量示例（复制为 .env 后按需修改）
# 注：默认 LLM_PROVIDER=mock，无需任何密钥即可运行；接入真实模型再配置以下项。

# LLM 接入（mock / openai）
LLM_PROVIDER=mock
# LLM_MODEL={LLM_API_MODEL_ID}
# LLM_BASE_URL={LLM_API_BASE_URL}
#   说明：LLM_BASE_URL 为基础地址，客户端自动拼接 /chat/completions；
#   若直接填写含 /chat/completions 的完整端点则不重复拼接。
# LLM_API_KEY={LLM_API_KEY}   # 可选：端点需要鉴权时填写

# Mock 模型（默认即可复现，不建议修改）
# MOCK_SEED=42
# MOCK_INTENT_LATENCY_MS=550
# MOCK_INTENT_JITTER_MS=100
# MOCK_GENERATION_LATENCY_MS=600
# MOCK_GENERATION_JITTER_MS=120
# MOCK_CLARIFICATION_LATENCY_MS=500
# MOCK_CLARIFICATION_JITTER_MS=100
# MOCK_TOKEN_LATENCY_MS=40
# MOCK_TOKEN_PRICE_PER_1K=0.15   # 元/千 token，成本门禁假设口径

# Workflow 执行参数
# FLOW_MAX_NODE_EXECUTIONS=10
# FLOW_NODE_TIMEOUT_MS=5000
# FLOW_MAX_RETRIES=2
# FLOW_RETRY_BACKOFF_MS=50

# RAG 检索参数
# RAG_SEARCH_MODE=hybrid
# RAG_TOP_K=5
# RAG_SCORE_THRESHOLD=0.3

# 故障注入（关键路径 / Checkpoint 恢复 / 自愈实验场景）
# FLOW_FAULT_ENABLED=true
# FLOW_FAULT_TARGET=response_generation   # 按节点类型或节点 id 注入
# FLOW_FAULT_NODE_ID=
# FLOW_FAULT_MODE=error        # timeout / error / down
# FLOW_FAULT_LATENCY_MS=3000
# FLOW_FAULT_LIMIT=0           # 前 limit 次注入后自愈（0=持续注入）

# 数据路径（默认相对项目根目录）
# FLOW_DB_PATH=data/flow.db
# FLOW_TEST_DATA_DIR=../../testing/test-data

# 监控指标：上下文窗口占用率的分母（教学口径；只影响观测，不影响业务行为）
# CONTEXT_WINDOW_TOKENS=8192

# 服务端口
# PORT=8000
# Langfuse 自托管观测导出（见 Langfuse 官方文档）
# LANGFUSE_ENABLED=false
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-YOUR_PUBLIC_KEY
# LANGFUSE_SECRET_KEY=sk-lf-YOUR_SECRET_KEY

# 客服工单 Multi-Agent - 环境变量示例（复制为 .env 后按需修改）
# 注：默认 LLM_PROVIDER=mock，无需任何密钥即可运行；接入真实模型再配置以下项。

# LLM 接入（mock / openai）
LLM_PROVIDER=mock
# LLM_MODEL={LLM_API_MODEL_ID}
# LLM_BASE_URL={LLM_API_BASE_URL}
#   说明：LLM_BASE_URL 为基础地址，客户端自动拼接 /chat/completions；
#   若直接填写含 /chat/completions 的完整端点则不重复拼接。
# LLM_API_KEY={LLM_API_KEY}   # 可选：端点需要鉴权时填写

# Mock 模型（默认即可复现，不建议修改）
# MOCK_SEED=42
# MOCK_PLAN_LATENCY_MS=600
# MOCK_PLAN_JITTER_MS=120
# MOCK_AGENT_LATENCY_MS=350
# MOCK_AGENT_JITTER_MS=70
# MOCK_VALIDATION_LATENCY_MS=200
# MOCK_TOKEN_LATENCY_MS=40

# Multi-Agent 编排参数
# SUPERVISOR_TIMEOUT_MS=8000
# AGENT_TIMEOUT_MS=3000
# AGENT_MAX_RETRIES=3
# AGENT_RETRY_BACKOFF_MS=50
# AGENT_BREAKER_THRESHOLD=5
# AGENT_BREAKER_WINDOW_MS=30000
# AGENT_PARALLEL_LIMIT=8
# AGENT_DEGRADATION=true

# 故障注入（级联故障 / 恢复测试场景）
# AGENT_FAULT_ENABLED=true
# AGENT_FAULT_TARGET=logistics_agent
# AGENT_FAULT_MODE=error        # timeout / error / down
# AGENT_FAULT_LATENCY_MS=3000
# AGENT_FAULT_LIMIT=0           # 前 limit 次注入后自愈（0=持续注入）

# 数据路径（默认相对项目根目录）
# AGENT_DB_PATH=data/agent.db
# AGENT_TEST_DATA_DIR=tests/test_data

# 监控指标：上下文窗口占用率的分母（教学口径；只影响观测，不影响业务行为）
# CONTEXT_WINDOW_TOKENS=8192

# 服务端口
# PORT=8000
# Langfuse 自托管观测导出（见 Langfuse 官方文档）
# 先在 Langfuse Web（默认 http://localhost:3000）项目 Settings → API Keys 生成密钥
# LANGFUSE_ENABLED=false
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-YOUR_PUBLIC_KEY
# LANGFUSE_SECRET_KEY=sk-lf-YOUR_SECRET_KEY

# 客服工单案例 - Docker 编排环境变量示例（compose 变量插值用）
#
# 使用方法：
#   cp .env.example .env
# 再把下方 Langfuse 段填好后 docker compose up -d 重建容器生效。
# 真实 .env 含密钥，已通过 .gitignore 排除，不要提交到仓库。
#
# 注意与各阶段目录 .env 的分工：
#   本文件（案例根 .env）：供根 docker-compose.yml 变量插值，容器内运行；
#   阶段目录 .env：供宿主机 run_dev.sh / 进程内脚本使用，HOST 为 localhost。

# Langfuse 自托管观测导出（见 Langfuse 官方文档）
# 密钥由 Langfuse Web（默认 http://localhost:3000）项目 Settings → API Keys 生成
LANGFUSE_ENABLED=false
# 容器内访问宿主机 Langfuse 必须用 host.docker.internal（勿写 localhost）
LANGFUSE_HOST=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=pk-lf-YOUR_PUBLIC_KEY
LANGFUSE_SECRET_KEY=sk-lf-YOUR_SECRET_KEY


# 本地演示数据库口令（MySQL root 与 Agent 共用）；共享或公网部署前必须修改
MYSQL_ROOT_PASSWORD=change-me
# 默认只绑定本机；需要局域网访问时再改为具体网卡地址
# MYSQL_BIND_IP=127.0.0.1
# JAVA_BIND_IP=127.0.0.1
# AGENT_BIND_IP=127.0.0.1
# FRONTEND_BIND_IP=127.0.0.1
